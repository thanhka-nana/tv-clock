<?xml version="1.0" encoding="utf-8"?>
<!--
    THEME 2 — Đồng hồ số kiểu Odometer.

    Chia màn hình thành 3 hàng 30% / 40% / 30%:
      - Hàng 1 (30%) : Ngày Dương lịch DD - MM - YYYY, căn giữa ngang + dính đáy
      - Hàng 2 (40%) : Đồng hồ số HH:MM:SS (giây màu đỏ) với hiệu ứng cuộn spring
      - Hàng 3 (30%) : Ngày Âm lịch + Can Chi, căn giữa ngang + dính trên
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_clock2"
    android:baselineAligned="false"
    android:orientation="vertical"
    tools:context=".DigitalClockActivity"
    tools:deviceIds="tv">

    <!-- ============================ Hàng 1 : Dương lịch (30%) ============================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30">

        <TextView
            android:id="@+id/tvDigitalSolarDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="@dimen/digital_date_bottom_margin"
            android:fontFamily="@font/svn_gill_sans"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:text="@string/solar_date_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="Thứ Ba - 10 - 11 - 2026" />
    </FrameLayout>

    <!-- ============================ Hàng 2 : Đồng hồ số (40%) ============================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40">

        <com.ntstudio.clock.OdometerClockView
            android:id="@+id/odometerClock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- ============================ Hàng 3 : Âm lịch (30%) ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:gravity="center_horizontal|top"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="@dimen/digital_lunar_top_margin"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <!-- Dòng 1: ngày/tháng/năm âm lịch -->
        <TextView
            android:id="@+id/tvDigitalLunarDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/svn_gill_sans"
            android:fontVariationSettings="'wght' 500"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="@string/lunar_date_placeholder"
            android:textColor="@color/clock2_text_primary"
            android:textSize="34sp"
            tools:text="02 - 10 - 2026" />

        <!-- Dòng 2: Can Chi theo 12 con giáp -->
        <TextView
            android:id="@+id/tvDigitalLunarCanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/svn_gill_sans"
            android:fontVariationSettings="'wght' 400"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="@string/lunar_canchi_placeholder"
            android:textColor="@color/clock2_accent"
            android:textSize="26sp"
            tools:text="Năm Bính Ngọ · Tháng Kỷ Hợi · Ngày Mậu Tý" />
    </LinearLayout>

</LinearLayout>
